# =============================================================================
# RAG Chatbot - Environment Configuration
# =============================================================================
# Copy this file to ".env" and fill in your values:
#     copy .env.example .env        (Windows)
#     cp   .env.example .env        (macOS / Linux)
# The .env file holds secrets and is git-ignored - never commit it.
# Every key below has a sane default in backend/config.py, so the only value you
# MUST set for live LLM calls is NVIDIA_API_KEY.
# -----------------------------------------------------------------------------

# ---- NVIDIA NIM (generation LLM) --------------------------------------------
# Free API key from https://build.nvidia.com (required for chat / smoke test).
# Leave empty for ingestion-only work (embeddings are local and need no key).
NVIDIA_API_KEY=

# Chat model id. Swap this to change models with NO code change.
# Examples: meta/llama-3.3-70b-instruct, meta/llama-3.1-8b-instruct,
#           mistralai/mixtral-8x7b-instruct-v0.1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OpenAI-compatible NIM endpoint. Rarely needs changing.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Generation sampling. Low temperature keeps answers grounded/deterministic.
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ---- Embeddings (local, offline, free) --------------------------------------
# Must be the SAME model for ingestion and query. 384-dim, ~130 MB on first use.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---- Storage paths ----------------------------------------------------------
# Relative paths are resolved against the project root by backend/config.py.
PDF_DIR=pdf_for_RAG
CHROMA_DIR=data/chroma
ASSETS_DIR=data/assets
METADATA_PATH=data/metadata.json
SQLITE_PATH=data/app.db

# ---- Vector store / retrieval tuning ----------------------------------------
# Chroma collection name (single unified collection).
COLLECTION_NAME=annual_reports

# Comma-separated origins allowed by the API's CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Number of text chunks retrieved per query.
TOP_K=8

# Number of visual chunks (table/image/figure) retrieved per query.
VISUAL_K=3

# Minimum similarity (0-1) for the visual "safety net" to attach an untagged
# visual. Tuned in Phase 6.4: relevant visuals score ~0.72-0.77, generic ones
# ~0.51, so 0.6 cleanly separates them. (LLM [VISUAL: id] tags bypass this.)
VISUAL_SIM_THRESHOLD=0.6

# ---- Reranking (retrieval -> rerank -> LLM) ---------------------------------
# A cross-encoder rescues relevant chunks that dense similarity buried: retrieve
# RERANK_CANDIDATES from Chroma, score each against the query, and hand only the
# top RERANK_TOP_N to the LLM. Set RERANK_ENABLED=false to restore the plain
# top-K path (fully backward compatible). Any failure also falls back silently.
RERANK_ENABLED=true

# Reranker backend:
#   nvidia - hosted NVIDIA NeMo Retriever NIM (reuses NVIDIA_API_KEY; no local model)
#   local  - sentence-transformers cross-encoder (offline, no key, ~280 MB download)
RERANK_BACKEND=nvidia

# Reranker model id - MUST match the backend:
#   nvidia: nv-rerank-qa-mistral-4b:1  (Mistral-4B QA reranker, hosted). NVIDIA rotates
#           hosted endpoints over time - on a 404/410 the chain auto-falls back to
#           plain top-k; to fix, list live ids via NVIDIARerank.get_available_models()
#           (then probe them) or set RERANK_BACKEND=local.
#   local : BAAI/bge-reranker-base (recommended) | cross-encoder/ms-marco-MiniLM-L-6-v2 (lighter)
RERANK_MODEL=nv-rerank-qa-mistral-4b:1

# Base URL for a self-hosted reranking NIM (e.g. http://localhost:8000/v1).
# Leave blank to use NVIDIA's hosted endpoint. Ignored by the local backend.
RERANK_BASE_URL=

# Candidates pulled from Chroma before reranking (the wider net the reranker sorts).
RERANK_CANDIDATES=24

# Final reranked chunks handed to the LLM.
RERANK_TOP_N=5
