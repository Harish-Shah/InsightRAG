data/chroma/
data/assets/
data/app.db
data/metadata.json
!data/chroma/.gitkeep
!data/assets/.gitkeep

# ---- Model / HF cache (in case it lands in the project) ----
.cache/
*.bin.lock

# ---- Frontend (Phase 5) ----
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# ---- Claude Code internals & local logs ----
.claude/
_reset.log

# ---- Editor / OS ----
.vscode/*
