# ---- Source PDFs (large files, not for version control) ----
pdf_for_RAG/

# ---- Secrets & environment ----
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
*.venv
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

